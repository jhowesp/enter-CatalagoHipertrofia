    where schemaname = 'storage' and tablename = 'objects'
      and policyname = 'product_images_admin_insert'
  ) then
    execute 'create policy "product_images_admin_insert" on storage.objects for insert to authenticated with check (bucket_id = ''product-images'' and public.is_admin())';
  end if;

  if not exists (
    select 1 from pg_policies
    where schemaname = 'storage' and tablename = 'objects'
      and policyname = 'product_images_admin_update'
  ) then
    execute 'create policy "product_images_admin_update" on storage.objects for update to authenticated using (bucket_id = ''product-images'' and public.is_admin()) with check (bucket_id = ''product-images'' and public.is_admin())';
  end if;

  if not exists (
    select 1 from pg_policies
    where schemaname = 'storage' and tablename = 'objects'
      and policyname = 'product_images_admin_delete'
