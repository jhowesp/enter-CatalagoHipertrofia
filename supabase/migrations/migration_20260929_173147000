  id uuid primary key default gen_random_uuid(),
  name text not null,
  slug text not null unique,
  brand_id uuid references public.brands (id) on delete set null,
  category_id uuid references public.categories (id) on delete set null,
  description text,
  short_description text,
  specs jsonb not null default '{}'::jsonb,
  weight text,
  flavor text,
  price numeric(10,2) not null default 0 check (price >= 0),
  sale_price numeric(10,2) check (sale_price is null or sale_price >= 0),
  cost_price numeric(10,2) check (cost_price is null or cost_price >= 0),
  image_url text,
  stock integer not null default 0 check (stock >= 0),
  featured boolean not null default false,
  active boolean not null default true,
  is_demo boolean not null default false,
  effective_price numeric(10,2) generated always as (coalesce(sale_price, price)) stored,
  discount_percent integer generated always as (
    case
      when sale_price is not null and sale_price < price and price > 0
        then (round((price - sale_price) / price * 100))::integer
      else 0
    end
  ) stored,
  margin_percent integer generated always as (
    case
      when cost_price is not null and coalesce(sale_price, price) > 0
        then (round((coalesce(sale_price, price) - cost_price) / coalesce(sale_price, price) * 100))::integer
      else null
    end
  ) stored,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

