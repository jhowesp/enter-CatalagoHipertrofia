create or replace function public.create_quote(
  p_customer_name text,
  p_customer_whatsapp text,
  p_notes text,
  p_items jsonb
)
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_quote_id uuid;
  v_total numeric(10,2);
  v_requested integer;
  v_resolved integer;
  v_units integer;
begin
  if length(trim(coalesce(p_customer_name, ''))) < 2 or length(trim(p_customer_name)) > 120 then
    raise exception 'invalid_customer_name';
  end if;

  if length(regexp_replace(coalesce(p_customer_whatsapp, ''), '\D', '', 'g')) < 10 then
    raise exception 'invalid_customer_whatsapp';
  end if;

  if p_items is null or jsonb_typeof(p_items) <> 'array' or jsonb_array_length(p_items) = 0 then
    raise exception 'empty_quote';
  end if;

  if jsonb_array_length(p_items) > 100 then
    raise exception 'too_many_items';
  end if;

  create temp table if not exists tmp_requested_items (
    product_id uuid,
    quantity integer,
    name text,
    unit_price numeric(10,2)
  ) on commit drop;

  truncate table tmp_requested_items;

  insert into tmp_requested_items (product_id, quantity, name, unit_price)
  select r.product_id, r.quantity, p.name, p.effective_price
  from (
    select (item ->> 'product_id')::uuid as product_id,
           sum((item ->> 'quantity')::integer) as quantity
    from jsonb_array_elements(p_items) as item
    where coalesce((item ->> 'quantity')::integer, 0) > 0
    group by 1
  ) r
  join public.products p on p.id = r.product_id and p.active = true;

  select count(*) into v_requested
  from (
    select (item ->> 'product_id')::uuid as product_id
    from jsonb_array_elements(p_items) as item
    where coalesce((item ->> 'quantity')::integer, 0) > 0
    group by 1
  ) x;

  select count(*), coalesce(sum(quantity), 0) into v_resolved, v_units
  from tmp_requested_items;

  if v_resolved <> v_requested or v_units = 0 then
    raise exception 'product_unavailable';
  end if;

  select coalesce(sum(quantity * unit_price), 0) into v_total from tmp_requested_items;

  insert into public.quotes (customer_name, customer_whatsapp, notes, total, status)
  values (
    trim(p_customer_name),
    trim(p_customer_whatsapp),
    nullif(trim(coalesce(p_notes, '')), ''),
    v_total,
    'new'
  )
  returning id into v_quote_id;

  insert into public.quote_items (quote_id, product_id, product_name, quantity, unit_price, subtotal)
  select v_quote_id, product_id, name, quantity, unit_price, quantity * unit_price
  from tmp_requested_items;

  return jsonb_build_object('quote_id', v_quote_id, 'total', v_total, 'units', v_units);
end;
$$;

create or replace view public.public_products
with (security_invoker = false) as
select
  p.id,
  p.name,
  p.slug,
  p.brand_id,
  b.name as brand_name,
  b.slug as brand_slug,
  p.category_id,
  c.name as category_name,
  c.slug as category_slug,
  p.description,
  p.short_description,
  p.specs,
  p.weight,
  p.flavor,
  p.price,
  p.sale_price,
  p.effective_price,
  p.discount_percent,
  p.image_url,
  p.stock,
  p.featured,
  p.created_at
from public.products p
left join public.brands b on b.id = p.brand_id
left join public.categories c on c.id = p.category_id
where p.active = true;

