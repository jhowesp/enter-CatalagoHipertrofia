create table public.banners (
  id uuid primary key default gen_random_uuid(),
  eyebrow text,
  title text not null check (length(trim(title)) >= 2),
  subtitle text,
  image_url text,
  cta_label text,
  cta_href text,
  active boolean not null default true,
  position integer not null default 0,
  is_demo boolean not null default false,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint banners_cta_href_scheme_check check (cta_href is null or cta_href ~ '^(/|https?://)')
);

create index banners_active_position_idx on public.banners (active, position);

create trigger banners_set_updated_at
before update on public.banners
for each row execute function public.set_updated_at();

alter table public.banners enable row level security;

create policy "banners_public_read_active"
on public.banners
for select
to anon, authenticated
using (active = true);

create policy "banners_admin_manage"
on public.banners
for all
to authenticated
using (public.is_admin())
with check (public.is_admin());

grant select on public.banners to anon, authenticated;
grant insert, update, delete on public.banners to authenticated;

insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values (
  'banner-images',
  'banner-images',
  true,
  5242880,
  array['image/jpeg', 'image/png', 'image/webp', 'image/avif']::text[]
)
on conflict (id) do nothing;

do $$
begin
  if not exists (
    select 1 from pg_policies
    where schemaname = 'storage' and tablename = 'objects'
      and policyname = 'banner_images_public_read'
  ) then
    execute 'create policy "banner_images_public_read" on storage.objects for select to public using (bucket_id = ''banner-images'')';
  end if;

  if not exists (
    select 1 from pg_policies
    where schemaname = 'storage' and tablename = 'objects'
      and policyname = 'banner_images_admin_insert'
  ) then
    execute 'create policy "banner_images_admin_insert" on storage.objects for insert to authenticated with check (bucket_id = ''banner-images'' and public.is_admin())';
  end if;

  if not exists (
    select 1 from pg_policies
    where schemaname = 'storage' and tablename = 'objects'
      and policyname = 'banner_images_admin_update'
  ) then
    execute 'create policy "banner_images_admin_update" on storage.objects for update to authenticated using (bucket_id = ''banner-images'' and public.is_admin()) with check (bucket_id = ''banner-images'' and public.is_admin())';
  end if;

  if not exists (
    select 1 from pg_policies
    where schemaname = 'storage' and tablename = 'objects'
      and policyname = 'banner_images_admin_delete'
  ) then
    execute 'create policy "banner_images_admin_delete" on storage.objects for delete to authenticated using (bucket_id = ''banner-images'' and public.is_admin())';
  end if;
end $$;

