create table public.product_variants (
  id uuid primary key default gen_random_uuid(),
  product_id uuid not null references public.products (id) on delete cascade,
  flavor text not null check (length(trim(flavor)) > 0),
  price numeric(10,2) check (price is null or price >= 0),
  sale_price numeric(10,2) check (sale_price is null or sale_price >= 0),
  stock integer not null default 0 check (stock >= 0),
  active boolean not null default true,
  position integer not null default 0,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint product_variants_flavor_unique unique (product_id, flavor)
);

create index product_variants_product_id_idx on public.product_variants (product_id);

create trigger product_variants_set_updated_at
before update on public.product_variants
for each row execute function public.set_updated_at();

alter table public.product_variants enable row level security;

create policy "product_variants_admin_manage"
on public.product_variants
for all
to authenticated
using (public.is_admin())
with check (public.is_admin());

create or replace view public.public_product_variants
with (security_invoker = false) as
select
  v.id,
  v.product_id,
  v.flavor,
  v.stock,
  v.position,
  coalesce(v.sale_price, v.price, p.sale_price, p.price) as price,
  coalesce(v.price, p.price) as list_price
from public.product_variants v
join public.products p on p.id = v.product_id
where v.active = true and p.active = true;

grant select on public.public_product_variants to anon, authenticated;
grant select, insert, update, delete on public.product_variants to authenticated;
revoke all on public.product_variants from anon;

alter table public.quote_items add column if not exists product_flavor text;

create or replace function public.create_quote(
  p_customer_name text,
  p_customer_whatsapp text,
  p_notes text,
  p_items jsonb
)
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_quote_id uuid;
  v_total numeric(10,2);
  v_requested integer;
  v_resolved integer;
  v_units integer;
begin
  if length(trim(coalesce(p_customer_name, ''))) < 2 or length(trim(p_customer_name)) > 120 then
    raise exception 'invalid_customer_name';
  end if;

  if length(regexp_replace(coalesce(p_customer_whatsapp, ''), '\D', '', 'g')) < 10 then
    raise exception 'invalid_customer_whatsapp';
  end if;

  if p_items is null or jsonb_typeof(p_items) <> 'array' or jsonb_array_length(p_items) = 0 then
    raise exception 'empty_quote';
  end if;

  if jsonb_array_length(p_items) > 100 then
    raise exception 'too_many_items';
  end if;

  select count(*) into v_requested
  from (
    select (item ->> 'product_id') as product_id,
           nullif(trim(coalesce(item ->> 'flavor', '')), '') as flavor
    from jsonb_array_elements(p_items) as item
    where coalesce(nullif(item ->> 'quantity', '')::integer, 0) > 0
      and coalesce(item ->> 'product_id', '') <> ''
    group by 1, 2
  ) req;

  if v_requested = 0 then
    raise exception 'empty_quote';
  end if;

  select count(*), coalesce(sum(r.quantity), 0), coalesce(sum(r.quantity * r.unit_price), 0)
    into v_resolved, v_units, v_total
  from (
    select (item ->> 'product_id')::uuid as product_id,
           nullif(trim(coalesce(item ->> 'flavor', '')), '') as flavor,
           sum(coalesce(nullif(item ->> 'quantity', '')::integer, 0)) as quantity
    from jsonb_array_elements(p_items) as item
    where coalesce(nullif(item ->> 'quantity', '')::integer, 0) > 0
      and coalesce(item ->> 'product_id', '') <> ''
    group by 1, 2
  ) r
  join public.products p on p.id = r.product_id and p.active = true
  left join public.product_variants v
    on v.product_id = p.id and v.active = true and v.flavor = r.flavor
  cross join lateral (
    select coalesce(v.sale_price, v.price, p.sale_price, p.price) as unit_price
  ) calc
  where r.flavor is null or v.id is not null;

  if v_resolved <> v_requested or v_units = 0 then
    raise exception 'product_unavailable';
  end if;

  insert into public.quotes (customer_name, customer_whatsapp, notes, total, status)
  values (
    trim(p_customer_name),
    trim(p_customer_whatsapp),
    nullif(trim(coalesce(p_notes, '')), ''),
    v_total,
    'new'
  )
  returning id into v_quote_id;

  insert into public.quote_items (quote_id, product_id, product_name, product_flavor, quantity, unit_price, subtotal)
  select v_quote_id, r.product_id, p.name, r.flavor, r.quantity, calc.unit_price, r.quantity * calc.unit_price
  from (
    select (item ->> 'product_id')::uuid as product_id,
           nullif(trim(coalesce(item ->> 'flavor', '')), '') as flavor,
           sum(coalesce(nullif(item ->> 'quantity', '')::integer, 0)) as quantity
    from jsonb_array_elements(p_items) as item
    where coalesce(nullif(item ->> 'quantity', '')::integer, 0) > 0
      and coalesce(item ->> 'product_id', '') <> ''
    group by 1, 2
  ) r
  join public.products p on p.id = r.product_id and p.active = true
  left join public.product_variants v
    on v.product_id = p.id and v.active = true and v.flavor = r.flavor
  cross join lateral (
    select coalesce(v.sale_price, v.price, p.sale_price, p.price) as unit_price
  ) calc
  where r.flavor is null or v.id is not null;

  return jsonb_build_object('quote_id', v_quote_id, 'total', v_total, 'units', v_units);
end;
$$;

grant execute on function public.create_quote(text, text, text, jsonb) to anon, authenticated;